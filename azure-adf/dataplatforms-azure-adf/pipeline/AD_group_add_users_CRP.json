					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": " SELECT DISTINCT \n    AD.ID AS USER_ID\n    ,CRP.LOGIN_ID AS USER_EMAIL\n    , 'b3671d93-be47-4d38-bd09-fdabcd4f6a70' AS GROUP_ID\n    , 'Power BI - COEX External - Refund Point Operators' AS GROUP_NAME\n    ,'ADD_TO_CRP_GROUP' AS OPERATION\n    , 'AD_Group_Add_Users_CRP' AS TRIGGERED_BY\n  FROM (SELECT LOGIN_ID, FULL_NAME, MAX(ACTIVE) AS ACTIVE, MAX(LAST_MODIFIED_ON_UTC) AS LAST_MODIFIED_ON_UTC FROM @{pipeline().parameters.TABLE_USER_HEADER}  GROUP BY ALL) CRP\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n    ON lower(CRP.LOGIN_ID) = lower(AD.MAIL)\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADG\n    ON AD.ID = ADG.USER_ID\n  WHERE 1=1\n  AND CRP.ACTIVE = 1\n     AND AD.EXTERNALUSERSTATE = 'Accepted'\n  AND AD.ID IS NOT NULL\n  AND CRP.LOGIN_ID NOT IN (SELECT DISTINCT MAIL FROM RAW_PROD.CES_ADF.AD_GROUP_MEMBERS ADG WHERE GROUP_ID = 'b3671d93-be47-4d38-bd09-fdabcd4f6a70' AND MAIL IS NOT NULL )",
								"type": "Expression"
							}
						}
					],
