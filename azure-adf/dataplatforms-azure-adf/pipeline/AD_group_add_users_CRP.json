{
	"name": "AD_group_add_users_CRP",
	"properties": {
		"activities": [
			{
				"name": "Get List of Users",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH USER_LIST AS (\n SELECT DISTINCT AD.ID AS USER_ID\n    ,CONCAT('https://graph.microsoft.com/v1.0/directoryObjects/', AD.ID) AS USER_LINK\n  FROM (SELECT LOGIN_ID, FULL_NAME, MAX(ACTIVE) AS ACTIVE, MAX(LAST_MODIFIED_ON_UTC) AS LAST_MODIFIED_ON_UTC FROM @{pipeline().parameters.TABLE_USER_HEADER}  GROUP BY ALL) CRP\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n    ON lower(CRP.LOGIN_ID) = lower(AD.MAIL)\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADG\n    ON AD.ID = ADG.USER_ID\n  WHERE 1=1\n  AND CRP.ACTIVE = 1\n  AND AD.EXTERNALUSERSTATE = 'Accepted'\n  AND AD.ID IS NOT NULL\n  AND lower(CRP.LOGIN_ID) NOT IN (SELECT DISTINCT lower(MAIL) MAIL FROM RAW_PROD.CES_ADF.AD_GROUP_MEMBERS ADG WHERE GROUP_ID = 'b3671d93-be47-4d38-bd09-fdabcd4f6a70' AND MAIL IS NOT NULL )\n)\nSELECT \n  'b3671d93-be47-4d38-bd09-fdabcd4f6a70' AS GROUP_ID // GROUP ID OF Power BI - COEX External - Refund Point Operators\n  ,ARRAY_AGG(USER_LINK) AS ARRAY\n  ,OBJECT_CONSTRUCT(\n    'members@odata.bind', ARRAY_AGG(USER_LINK)\n  ) AS API_BODY\nFROM USER_LIST",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
