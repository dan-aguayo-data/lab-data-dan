{
	"name": "SEND_EMAIL_GENERIC",
	"properties": {
		"activities": [
			{
				"name": "SEND_EMAIL_GENERIC",
				"description": "Generic Web Activity to send email",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@pipeline().globalParameters.lapp_ad_crp_ext_send_email_PARAM_DEV",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"Body\": \"@{pipeline().parameters.Body}\",\n    \"Email\": \"@{pipeline().parameters.Email}\",\n    \"Subject\": \"@{pipeline().parameters.Subject}\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Email": {
				"type": "string",
				"defaultValue": "data-team@cesystems.com"
			},
			"Subject": {
				"type": "string",
				"defaultValue": "Enter Subject"
			},
			"Body": {
				"type": "string",
				"defaultValue": "Enter Body"
			}
		},
		"folder": {
			"name": "Generic"
		},
		"annotations": []
	}
}