{
	"name": "AD_group_add_users_ext",
	"properties": {
		"activities": [
			{
				"name": "Get List of Users",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH USER_LIST AS (\n  SELECT DISTINCT AD.ID AS USER_ID\n    ,CONCAT('https://graph.microsoft.com/v1.0/directoryObjects/', AD.ID) AS USER_LINK\n  FROM @{pipeline().parameters.TABLE_USER_HEADER} COEX\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n    ON lower(COEX.LOGIN_ID) = lower(AD.MAIL)\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADG\n    ON AD.ID = ADG.USER_ID\n  WHERE 1=1\n    AND COEX.ACTIVE = 1\n    AND lower(COEX.LOGIN_ID) NOT IN (SELECT DISTINCT lower(MAIL) FROM RAW_PROD.CES_ADF.AD_GROUP_MEMBERS ADG WHERE GROUP_ID = '3b8e9bda-66bd-49a9-979e-5fc53c61cc94' AND MAIL IS NOT NULL )\n    AND AD.EXTERNALUSERSTATE = 'Accepted'\n)\nSELECT \n  '3b8e9bda-66bd-49a9-979e-5fc53c61cc94' AS GROUP_ID // GROUP ID OF Power BI - COEX External - Partners\n  ,ARRAY_AGG(USER_LINK) AS ARRAY\n  ,OBJECT_CONSTRUCT(\n    'members@odata.bind', ARRAY_AGG(USER_LINK)\n  ) AS API_BODY\nFROM USER_LIST\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Get Audit Metadata",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "  SELECT DISTINCT \n  AD.ID AS USER_ID, \n LOGIN_ID, \n'3b8e9bda-66bd-49a9-979e-5fc53c61cc94' AS GROUP_ID, \n'Power BI - COEX External - Partners' AS GROUP_NAME, \n'ADD' AS OPERATION\nFROM @{pipeline().parameters.TABLE_USER_HEADER} COEX\nLEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n  ON lower(COEX.LOGIN_ID) = lower(AD.MAIL)\nLEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADG\n  ON AD.ID = ADG.USER_ID\nWHERE \n   COEX.ACTIVE = 1\n  AND lower(COEX.LOGIN_ID) NOT IN (SELECT DISTINCT lower(MAIL) FROM RAW_PROD.CES_ADF.AD_GROUP_MEMBERS ADG WHERE GROUP_ID = '3b8e9bda-66bd-49a9-979e-5fc53c61cc94' AND MAIL IS NOT NULL )\n    AND AD.EXTERNALUSERSTATE = 'Accepted'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Audit Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set triggered_by",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "If Condition2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Audit Metadata').output.resultSets[0].rows",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set user_id",
