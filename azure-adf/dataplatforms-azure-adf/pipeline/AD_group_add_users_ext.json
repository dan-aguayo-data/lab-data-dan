									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set group_id",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set group_name",
									"dependencyConditions": [
										"Succeeded"
									]
