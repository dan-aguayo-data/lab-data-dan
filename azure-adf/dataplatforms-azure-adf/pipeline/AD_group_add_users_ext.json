						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Get List of Users').output.resultSets[0].rows[0].ARRAY, '[]'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Add Users to Group",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "PATCH",
								"url": {
									"value": "https://graph.microsoft.com/v1.0/groups/@{activity('Get List of Users').output.resultSets[0].rows[0].GROUP_ID}",
									"type": "Expression"
								},
								"body": {
									"value": "@activity('Get List of Users').output.resultSets[0].rows[0].API_BODY",
									"type": "Expression"
