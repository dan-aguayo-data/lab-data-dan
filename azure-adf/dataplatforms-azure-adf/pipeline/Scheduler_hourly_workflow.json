{
	"name": "Scheduler_hourly_workflow",
	"properties": {
		"activities": [
			{
				"name": "Get current time",
				"description": "Get current_time as a variable, time is taken in terms of hours from 0 to 23 ",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_time_scheduler_hourly",
					"value": {
						"value": "@substring(convertTimeZone(pipeline().TriggerTime,'UTC','AUS Eastern Standard Time'),11,2)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check for FIN RTP",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "DBT_scheduler_hourly",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(int(variables('current_time_scheduler_hourly')),6)\n,equals(int(variables('current_time_scheduler_hourly')),12))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "MasterData-PROD-FINRTP",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "POWERBI_REFRESH_DATASET_GENERIC",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"WorkspaceID": {
										"value": "@pipeline().globalParameters.P_TARGET_WORKSPACEID_POWERBI_CES_PARAM_DEV",
										"type": "Expression"
									},
									"DatasetID": {
										"value": "@pipeline().globalParameters.P_PBI_DATASETID_CES_MASTERDATA_FINRTP_PARAM_DEV",
										"type": "Expression"
									},
									"NameReference": "MasterData-PROD-FINRTP",
									"PipelineReference": "Scheduler_hourly_time_check"
								}
							}
						},
						{
							"name": "MasterData-PROD-FINRTP-KAFKA",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "POWERBI_REFRESH_DATASET_GENERIC",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"WorkspaceID": {
										"value": "@pipeline().globalParameters.P_TARGET_WORKSPACEID_POWERBI_CES_PARAM_DEV",
										"type": "Expression"
									},
									"DatasetID": {
										"value": "@pipeline().globalParameters.P_PBI_DATASETID_CES_MASTERDATA_FINRTP_KAFKA_PARAM_DEV",
										"type": "Expression"
									},
									"NameReference": "MasterData-PROD-FINRTP-KAFKA",
									"PipelineReference": "Scheduler_hourly_time_check"
								}
							}
						}
					]
				}
			},
			{
				"name": "DBT_scheduler_hourly",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Get current time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Scheduler_hourly_child",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"variables": {
			"current_time_scheduler_hourly": {
				"type": "String"
			}
		},
		"folder": {
			"name": "DBT_PBI_FLOWS/wf"
		},
		"annotations": []
	}
}