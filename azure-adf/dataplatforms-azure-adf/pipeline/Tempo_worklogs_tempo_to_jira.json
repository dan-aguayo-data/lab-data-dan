{
	"name": "Tempo_worklogs_tempo_to_jira",
	"properties": {
		"activities": [
			{
				"name": "Extract Data into Blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Payload_variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "POST",
						"requestBody": {
							"value": "@concat('{\"tempoWorklogIds\": ', variables('Payload_String'), '}')\n",
							"type": "Expression"
						},
						"additionalHeaders": {
							"Content-Type": "application/json",
							"Host": "api.tempo.io"
						},
						"paginationRules": {
							"AbsoluteUrl": "$.metadata.next"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "arrayOfObjects"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "Tempo_api_pvar_PARAM_PROD",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "CES_tempo_blob_PARAM_DEV",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Get JSON Payload",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH LATEST_FILE as (\n    SELECT *\n    FROM \n    LANDING.SNOWPIPE_PROD.CES_TEMPO_PROD\n    WHERE\n    FILE_NAME=(\n      select FILE_NAME from LANDING.SNOWPIPE_PROD.CES_TEMPO_PROD\n      where lower(FILE_NAME) like lower('WORKLOGS/%')\n      QUALIFY row_number() OVER (PARTITION BY 'WORKLOGS' ORDER BY LANDED_DATETIME DESC) = 1 )\n),   \nsource as (\n  SELECT *\n  FROM LATEST_FILE s,\n  lateral flatten(input => s.message:results) f\n    \n)\nSELECT\n        ARRAY_AGG(s.value:tempoWorklogId::bigint) AS TEMPOWORKLOGID\n\nFROM source s",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Payload_variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get JSON Payload",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Payload_String",
					"value": {
						"value": "@string(activity('Get JSON Payload').output.resultSets[0].rows[0].TEMPOWORKLOGID)\n",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"API_Name": {
				"type": "string",
				"defaultValue": "TEMPO_TO_JIRA"
			},
			"API_URL": {
				"type": "string",
				"defaultValue": "4/worklogs/tempo-to-jira?limit=5000"
			}
		},
		"variables": {
			"test": {
				"type": "String"
			},
			"test_2": {
				"type": "String"
			},
			"Payload": {
				"type": "Array"
			},
			"Payload_String": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Tempo"
		},
		"annotations": []
	}
}