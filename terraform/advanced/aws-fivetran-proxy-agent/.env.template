# .env.template
# Template for load-env.ps1
# Copy this to load-env.ps1 and fill in actual values
# DO NOT COMMIT load-env.ps1 TO GIT!

# ============================================================================
# How to use this template:
# 1. Copy this file: Copy-Item .env.template load-env.ps1
# 2. Edit load-env.ps1 and replace placeholders with actual values
# 3. Run: .\load-env.ps1
# 4. Run: terraform apply
# ============================================================================

# Fivetran Proxy Agent credentials (from Fivetran UI)
TF_VAR_fivetran_proxy_api_key=YOUR_API_KEY_HERE
TF_VAR_fivetran_proxy_api_secret=YOUR_API_SECRET_HERE

# Your VPC ID (from AWS)
TF_VAR_vpc_id=vpc-XXXXXXXXX

# Private subnet ID with NAT Gateway
TF_VAR_subnet_id=subnet-XXXXXXXXX

# MSSQL instance security group ID
TF_VAR_mssql_security_group_id=sg-XXXXXXXXX

# MSSQL host (IP address or hostname)
TF_VAR_mssql_host=10.x.x.x

# Optional: EC2 instance type
TF_VAR_instance_type=t3.small
