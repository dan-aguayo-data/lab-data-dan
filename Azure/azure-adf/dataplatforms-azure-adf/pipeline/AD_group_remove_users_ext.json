							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Delete User from Group",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set user_id",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set user_email",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set group_name",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set Operation",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set triggered_by",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
