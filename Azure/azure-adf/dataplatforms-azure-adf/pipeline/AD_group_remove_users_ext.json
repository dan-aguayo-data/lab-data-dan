										"type": "Expression"
									},
									"user_email": {
										"value": "@variables('user_email')",
										"type": "Expression"
									},
									"group_id": {
										"value": "@variables('group_id')",
										"type": "Expression"
									},
									"group_name": {
										"value": "@variables('group_name')",
										"type": "Expression"
									}
								}
							}
						},
						{
