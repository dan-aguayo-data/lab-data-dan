{
	"name": "AD_update_user_status_coex_int",
	"properties": {
		"activities": [
			{
				"name": "Get User List and Status",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH GROUP_TABLE AS (\n    SELECT ADG.ID AS GROUP_ID, ADGM.USER_ID, ADG.DISPLAYNAME FROM \"RAW_PROD\".\"CES_ADF\".\"AD_GROUPS\" AS ADG\n    LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADGM\n      ON ADG.ID = ADGM.GROUP_ID\n    WHERE ADG.DISPLAYNAME LIKE 'Power BI - COEX%'\n)\n,COEX AS (\n  SELECT * FROM \"COEX_PROD\".\"COEX_AGILOFT\".\"AG_COEX_EMPLOYEE_SECURITY_MAPPING\" COEX\n  QUALIFY row_number() OVER (PARTITION BY COEX_LOGIN_ID, AD_GROUP  ORDER BY DATE_UPDATED DESC) = 1\n)\nSELECT\n    AD.ID AS USER_ID\n    ,COEX_LOGIN_ID AS LOGIN_ID\n    ,CASE WHEN SUM(COEX.ACTIVE) >= 1 THEN 'ACTIVATE USER' ELSE 'DEACTIVATE USER' END AS OPERATION\n    ,OBJECT_CONSTRUCT(\n      'accountEnabled', CASE WHEN SUM(COEX.ACTIVE) >= 1 THEN TRUE ELSE FALSE END\n    ) AS API_BODY\nFROM COEX\nLEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n  ON LOWER(COEX.COEX_LOGIN_ID) = LOWER(AD.MAIL)\nLEFT JOIN GROUP_TABLE AS GT\n  ON COEX.AD_GROUP = GT.DISPLAYNAME\nWHERE COEX.DATE_UPDATED >= DATEADD(DAY ,-1,  CURRENT_DATE())\n  AND AD.ID IS NOT NULL\n  AND GROUP_ID IS NOT NULL\nGROUP BY AD.ID, LOGIN_ID",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
