{
	"name": "Scheduler_hourly_grandchild_fr",
	"properties": {
		"activities": [
			{
				"name": "Get current time",
				"description": "Get current_time as a variable, time is taken in terms of hours from 0 to 23 ",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_time_dbt_scheduler_hourly",
					"value": {
						"value": "@substring(convertTimeZone(pipeline().TriggerTime,'UTC','AUS Eastern Standard Time'),11,2)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If it is full refresh power bi",
				"description": "",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get current time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(int(variables('current_time_dbt_scheduler_hourly')),5)\n,equals(int(variables('current_time_dbt_scheduler_hourly')),13))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Execute DBT_run_jobs_hourly_false",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "DBT_run_jobs_hourly",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "Scheduler_PBI_refresh_datasets_hourly",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute DBT_run_jobs_hourly_false",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PBI_Scheduler_refresh_datasets_hourly",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Execute DBT_run_jobs_hourly",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "DBT_run_jobs_hourly",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						},
						{
							"name": "PBI_refresh_master_data_prod",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "Execute DBT_run_jobs_hourly",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
