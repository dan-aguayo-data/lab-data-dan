{
	"name": "Scheduler_frequent_workflow",
	"properties": {
		"activities": [
			{
				"name": "Get current time",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "current_time_scheduler",
					"value": {
						"value": "@substring(convertTimeZone(pipeline().TriggerTime,'UTC','AUS Eastern Standard Time'),11,2)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If_during_night_time_dont_run",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get current time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(int(variables('current_time_scheduler')), 0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Execute DBT_scheduler_frequent_prod",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Scheduler_frequent_child",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Do Nothing",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			}
		],
		"concurrency": 1,
		"policy": {
			"elapsedTimeMetric": {
				"duration": "0.00:20:00"
			}
		},
		"variables": {
			"current_time_scheduler": {
				"type": "String"
			}
		},
		"folder": {
			"name": "DBT_PBI_FLOWS/wf"
		},
		"annotations": []
	}
}