				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH GROUP_TABLE AS (\n    SELECT ADG.ID AS GROUP_ID, ADGM.USER_ID, ADG.DISPLAYNAME FROM \"RAW_PROD\".\"CES_ADF\".\"AD_GROUPS\" AS ADG\n    LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADGM\n      ON ADG.ID = ADGM.GROUP_ID\n    WHERE ADG.DISPLAYNAME LIKE 'Power BI - COEX%'\n)\nSELECT DISTINCT AD.ID AS USER_ID\n    ,COEX_LOGIN_ID AS LOGIN_ID\n    ,GROUP_ID\n    ,GT.DISPLAYNAME AS GROUP_NAME\n    ,'ADD' AS OPERATION\nFROM \"COEX_PROD\".\"COEX_AGILOFT\".\"AG_COEX_EMPLOYEE_SECURITY_MAPPING\" COEX\nLEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n  ON LOWER(COEX.COEX_LOGIN_ID) = LOWER(AD.MAIL)\nLEFT JOIN GROUP_TABLE AS GT\n  ON COEX.AD_GROUP = GT.DISPLAYNAME\nWHERE COEX.DATE_UPDATED >= DATEADD(DAY ,-1,  CURRENT_DATE())\n  AND AD.ID IS NOT NULL\n  AND GROUP_ID IS NOT NULL\n  AND COEX.ACTIVE = 1\n  AND AD_GROUP_STATUS = 'NEW'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
