{
	"name": "AD_group_add_users_coex_int",
	"properties": {
		"activities": [
			{
				"name": "Get List of Users",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "SNOWFLAKE_ADF_CES_GENERIC_PROD",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "WITH GROUP_TABLE AS (\n    SELECT ADG.ID AS GROUP_ID, ADGM.USER_ID, ADG.DISPLAYNAME FROM \"RAW_PROD\".\"CES_ADF\".\"AD_GROUPS\" AS ADG\n    LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_GROUP_MEMBERS\" AS ADGM\n      ON ADG.ID = ADGM.GROUP_ID\n    WHERE ADG.DISPLAYNAME LIKE 'Power BI - COEX%'\n)\n,USER_LIST AS (\n  SELECT DISTINCT GT.GROUP_ID\n    ,CONCAT('https://graph.microsoft.com/v1.0/directoryObjects/', AD.ID) AS USER_LINK\n    ,GT.DISPLAYNAME\n  FROM \"COEX_PROD\".\"COEX_AGILOFT\".\"AG_COEX_EMPLOYEE_SECURITY_MAPPING\" COEX\n  LEFT JOIN \"RAW_PROD\".\"CES_ADF\".\"AD_USERS\" AS AD\n    ON LOWER(COEX.COEX_LOGIN_ID) = LOWER(AD.MAIL)\n  LEFT JOIN GROUP_TABLE AS GT\n    ON COEX.AD_GROUP = GT.DISPLAYNAME\n  WHERE COEX.DATE_UPDATED >= DATEADD(DAY ,-1,  CURRENT_DATE())\n    AND AD.ID IS NOT NULL\n    AND GROUP_ID IS NOT NULL\n    AND COEX.ACTIVE = 1\n    AND AD_GROUP_STATUS = 'NEW'\n)\nSELECT \n  GROUP_ID\n  ,OBJECT_CONSTRUCT(\n    'members@odata.bind', ARRAY_AGG(USER_LINK)\n  ) AS API_BODY\nFROM USER_LIST\nGROUP BY GROUP_ID",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
