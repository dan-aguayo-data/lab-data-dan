{
	"name": "ELMO_department",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"additionalColumns": [
							{
								"name": "LANDED_DATETIME",
								"value": {
									"value": "@pipeline().TriggerTime",
									"type": "Expression"
								}
							}
						],
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "SnowflakeV2Sink",
						"importSettings": {
							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "Elmo_blob_storage",
							"type": "LinkedServiceReference"
						},
						"path": "elmo"
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['parent']"
								},
								"sink": {
									"name": "PARENT",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "ID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['description']"
								},
								"sink": {
									"name": "DESCRIPTION",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['departmentId']"
								},
								"sink": {
									"name": "DEPARTMENTID",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['title']"
								},
								"sink": {
									"name": "TITLE",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['path']"
								},
								"sink": {
									"name": "PATH",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['deleted']"
								},
								"sink": {
									"name": "DELETED",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['LANDED_DATETIME']"
								},
								"sink": {
									"name": "LANDED_DATETIME"
								}
							}
						],
						"collectionReference": ""
					}
				},
				"inputs": [
					{
						"referenceName": "Elmo_departments_PARAM_DEV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SNOWFLAKE_ELMO_DEPARTMENTS_KP",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "ELMO"
		},
		"annotations": []
	}
}